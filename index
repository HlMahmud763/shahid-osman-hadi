<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>শহীদ ওসমান হাদী</title>

<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@600;700&family=Noto+Serif+Bengali:wght@400;700&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;}
body{
    font-family:'Noto Serif Bengali', serif;
    background: linear-gradient(rgba(255,255,255,0.92), rgba(255,255,255,0.92)), url("https://i.imgur.com/1ZQZ1Zm.png");
    background-size: cover;
    color: #333;
    overflow-x: hidden;
}
/* 🌸 Flowers/Petals Animation */
.flower{
    position:fixed;
    top:-10%;
    font-size:22px;
    animation:fall linear infinite;
    opacity:.7;
    z-index:1;
}
@keyframes fall{
    0%{transform: translateY(-10vh) rotate(0deg);}
    100%{transform: translateY(120vh) rotate(360deg);}
}

/* Header */
header{
    text-align:center;
    padding:80px 20px 40px;
    position:relative;
    z-index:2;
    opacity:0;
    animation:fadeIn 1.5s forwards 0.3s;
}
header h1{
    font-family:'Hind Siliguri',sans-serif;
    font-size:48px;
    color:#006a4e;
    letter-spacing:2px;
}

/* FadeIn Animation */
@keyframes fadeIn{to{opacity:1;}}

/* Main Card */
.card{
    max-width:900px;
    margin:auto;
    background:#fff;
    padding:50px 35px;
    border-radius:20px;
    box-shadow:0 18px 40px rgba(0,0,0,.15);
    text-align:center;
    position:relative;
    z-index:2;
    opacity:0;
    transform: translateY(30px);
    animation:fadeInUp 1.5s forwards 0.6s;
}
@keyframes fadeInUp{to{opacity:1; transform: translateY(0);}}
/* Profile Image */
.profile-img {
    width:260px;
    height:260px;
    object-fit: cover;
    border-radius:50%;
    border:6px solid rgba(255, 255, 255, 0.8);
    box-shadow:0 10px 25px rgba(0,0,0,0.25);
    margin: 25px auto 15px;
    display: block;
    background-color: #fff;
}
/* Name and Years */
.name-title {text-align:center; font-size:28px; font-weight:bold; margin-top:10px;}
.life-span {text-align:center; font-size:18px; color:#555; margin-bottom:20px;}
/* Candle */
.candle{margin:25px auto;width:32px;height:65px;background:#fff3cd;border-radius:6px;position:relative;}
.flame{width:15px;height:24px;background:orange;border-radius:50%;position:absolute;top:-22px;left:8px;animation:flicker 0.15s infinite;}
@keyframes flicker{0%{transform:scale(1) translateY(0);}50%{transform:scale(.85) translateY(-2px);}100%{transform:scale(1) translateY(0);}}

/* Button */
.bio-btn{
    display:inline-block;
    margin:35px 0;
    padding:15px 45px;
    font-size:18px;
    color:white;
    text-decoration:none;
    border-radius:40px;
    background:linear-gradient(270deg,#006a4e,#00a97f,#006a4e);
    background-size:600% 600%;
    animation:gradient 4s ease infinite,fadeInUp 1.5s forwards 1.2s;
    box-shadow:0 12px 28px rgba(0,0,0,.25);
}
@keyframes gradient{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%;}}

/* About section */
.about{font-size:18px; line-height:1.9; text-align:justify; margin-top:20px; opacity:0; animation:fadeInUp 1.5s forwards 1.5s;}

/* Footer */
footer{margin-top:70px;background:#006a4e;color:white;text-align:center;padding:35px 15px;font-size:15px;}
footer span{display:block;margin-top:8px;font-style:italic;}

/* Responsive */
@media(max-width:600px){header h1{font-size:32px;}.name-title{font-size:24px;}.life-span{font-size:16px;}.about{font-size:16px;}}
</style>
</head>
<body>

<!-- 🌸 Flowers/Petals Script -->
<script>
for(let i=0;i<25;i++){
 let f=document.createElement("div");
 f.className="flower";
 f.innerHTML = ["🌸","🌺","🍃"][Math.floor(Math.random()*3)];
 f.style.left=Math.random()*100+"vw";
 f.style.fontSize = (15+Math.random()*20)+"px";
 f.style.animationDuration = (6+Math.random()*6)+"s";
 document.body.appendChild(f);
}
</script>

<header><h1>শহীদ ওসমান হাদী</h1></header>

<section class="card">
<img src="shahid.jpg" alt="শহীদ ওসমান হাদী" class="profile-img">
<div class="name-title">শহীদ ওসমান হাদী</div>
<div class="life-span">১৯৯৩ –  ∞</div>

<div class="candle"><div class="flame"></div></div>
<a href="biography.html" class="bio-btn">জীবনী</a>

<div class="about">
শহীদ ওসমান হাদী ছিলেন একজন নির্ভীক ও আত্মত্যাগী মানুষ, যিনি ন্যায়, সত্য ও মানবতার পক্ষে দাঁড়িয়ে নিজের জীবন উৎসর্গ করেছেন। তাঁর ত্যাগ ও আদর্শ জাতির বিবেককে চিরকাল জাগ্রত রাখবে।
</div>
</section>

<footer>FiAmanillah, Thanks For Your Time.<span>It's Mahmud Patwary (MP) ©2025</span></footer>
</body>
</html>
